rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user reads and writes their own tracking data alone. `{document=**}`
    // reaches every subcollection, so a new one is gated without editing this.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
